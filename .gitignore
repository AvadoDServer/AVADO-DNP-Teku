# DAppNodeSDK release directories
build_*
releases.json
testKeys

# Generated per network by build/ui-config.sh (the Dockerfile runs it with NETWORK)
build/wizard/src/server_config.json
build/monitor/server_config.json
build/monitor/settings/defaultsettings.json

# scripts/render.sh and scripts/prove-equivalence.sh output (when pointed inside the repo)
.render/
.proof/

# Each network's release record is kept in git (release.yml writes it)
!package_variants/*/releases.json
