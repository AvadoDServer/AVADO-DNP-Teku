+    ${P2P_QUIC_DISABLED:+--Xp2p-quic-enabled=false} \
     ${DISCOVERY_BOOTNODES:+--p2p-discovery-bootnodes=${DISCOVERY_BOOTNODES}} &
   
   sleep 5
